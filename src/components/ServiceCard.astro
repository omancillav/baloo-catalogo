---
import type { Service } from "../data/services";
import { themeStyles } from "../data/services";

export interface Props {
  service: Service;
}

const { service } = Astro.props;
const theme = themeStyles[service.color];
---

<article
  class={`group relative overflow-hidden rounded-3xl bg-[#16181d] border-2 border-white/5 transition-all duration-300 hover:-translate-y-2 ${theme.glow} hover:border-current ${theme.text} ${service.cols}`}
>
  <div
    class={`absolute -top-10 -right-10 w-32 h-32 ${theme.bg} rounded-full blur-[50px] opacity-0 group-hover:opacity-20 transition-opacity duration-500`}
  />

  <div class="p-8 relative z-10">
    <div class="flex items-center justify-between mb-8">
      <div
        class={`px-4 py-2 rounded-full ${theme.bgSoft} border border-current flex items-center gap-3`}
      >
        <span class="text-2xl">{service.icon}</span>
        <span class="text-xs font-bold tracking-widest uppercase opacity-80">
          {service.tag}
        </span>
      </div>

      <div class="opacity-0 group-hover:opacity-100 transform translate-x-4 group-hover:translate-x-0 transition-all duration-300">
         <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </div>
    </div>

    <h3 class="text-3xl font-black mb-6 text-white group-hover:text-current transition-colors">
      {service.title}
    </h3>

    <ul class="space-y-4 mb-6">
      {service.items.map((item) => (
        <li class="flex items-start text-gray-400">
          <span class={`mt-1.5 w-1.5 h-1.5 rounded-full ${theme.bg} mr-3 shadow-[0_0_10px_var(--color-${service.color})]`} />
          <span class="text-sm font-medium leading-relaxed">{item}</span>
        </li>
      ))}
    </ul>

    {service.note && (
      <div class={`mt-4 p-4 rounded-xl ${theme.bgSoft} border border-white/5 ${theme.text} flex gap-3 items-start`}>
        <span class="text-xl leading-none">⚠️</span>
        <span class="text-sm font-medium">{service.note}</span>
      </div>
    )}
  </div>

  <div class="absolute bottom-0 left-0 w-full h-1 bg-linear-to-r from-transparent via-current to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 transform scale-x-50 group-hover:scale-x-100"/>
</article>
