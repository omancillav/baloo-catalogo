---
import { Image } from "astro:assets";
---

<header
  class="min-h-screen flex flex-col justify-center items-center text-center px-4 pt-32 pb-24 relative overflow-hidden"
>
  <div class="relative w-72 md:w-96 aspect-square mb-12 animate-float">
    <div
      class="absolute inset-0 bg-linear-to-tr from-cyan via-magenta to-yellow rounded-full blur-[60px] opacity-40 animate-pulse-glow"
    >
    </div>
    <Image src="/logo.webp" alt="Baloo Logo" width={384} height={384} class="relative w-full h-full object-contain drop-shadow-2xl" />
  </div>

  <h1 class="text-4xl md:text-7xl font-black mb-6 tracking-tight leading-tight">
    <span class="block text-white">IMPRESIONES QUE</span>
    <span class="bg-linear-to-r from-cyan to-magenta bg-clip-text text-transparent">COBRAN VIDA</span>
  </h1>

  <p class="text-xl md:text-2xl text-gray-400 max-w-2xl mx-auto mb-10 font-light">
    Tu centro de soluciones creativas. Fotografía, impresión, diseño y más, con la calidad que mereces.
  </p>

  <div class="flex flex-col md:flex-row gap-4 w-full md:w-auto">
    <a
      href="https://wa.me/message/KRLBDWJ5KYCGI1"
      target="_blank"
      rel="noopener noreferrer"
      class="px-8 py-4 bg-transparent border border-gray-600 text-white rounded-full font-bold hover:border-white transition-all w-full md:w-auto flex justify-center"
      >Contáctanos</a
    >
    <a
      href="#services"
      class="px-8 py-4 bg-linear-to-r from-cyan to-magenta text-white rounded-full font-bold shadow-[0_0_20px_-5px_var(--color-magenta)] hover:shadow-[0_0_30px_0px_var(--color-magenta)] transition-all transform hover:-translate-y-1 w-full md:w-auto flex justify-center"
      >Explorar Servicios</a
    >
  </div>

  <div class="absolute bottom-10 animate-bounce cursor-pointer" onclick="window.scrollTo({top: window.innerHeight, behavior: 'smooth'})">
    <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
      ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"
      ></path></svg
    >
  </div>
</header>
