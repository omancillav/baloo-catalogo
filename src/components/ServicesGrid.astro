---
import { services } from "../data/services";
import ServiceCard from "./ServiceCard.astro";
---

<section id="services" class="max-w-7xl mx-auto px-6 mb-32">
  <h2 class="text-6xl md:text-8xl font-black mb-20 text-center text-white/5 uppercase tracking-tighter absolute w-full left-0 pointer-events-none select-none">Baloo 2026</h2>
  <h2 class="text-4xl md:text-5xl font-black mb-16 text-center text-white relative z-10">CATÁLOGO DE <span class="bg-linear-to-r from-cyan to-yellow bg-clip-text text-transparent">SERVICIOS</span></h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 relative z-10">
    {services.map((service) => (
      <ServiceCard service={service} />
    ))}
  </div>
</section>
